                                      https://githubusercontent.com"
>
    <entity
        table="vacancies"
        name="App\VacancyGrabber\Domain\Vacancy\Entity\Vacancy"
        repository-class="App\VacancyGrabber\Domain\Vacancy\Repository\VacancyRepositoryInterface"
    >
