        <id name="id" type="uuid">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"/>
        </id>


        <field name="title" column="title" type="text" length="255" nullable="true" />
        <field name="description" column="description" type="text" length="65535" nullable="true" />
        <field name="externalId" column="external_id" type="text" length="255" nullable="true" />
        <field name="url" column="url" type="text" length="255" nullable="true" />
        <field name="salary" column="salary" type="text" length="255" nullable="true" />

        <field name="viewed" column="viewed" type="boolean" nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>

        <field name="resumeSentAt" column="resume_sent_at" type="datetime_immutable"  precision="6" nullable="true" />
        <field name="deadLineAt" column="dead_line_at" type="datetime_immutable"  precision="6" nullable="true"/>

        <field name="createdAt" type="datetime_immutable" precision="6" nullable="true">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime_immutable" precision="6" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

