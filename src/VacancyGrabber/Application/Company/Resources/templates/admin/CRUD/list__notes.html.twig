{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}
{# @var \App\VacancyGrabber\Application\Company\Admin\CompanyAdmin admin #}
{# @var \App\VacancyGrabber\Domain\Company\Entity\Company object #}

{% block field %}
    <div>
        <strong>{{ 'COMPANY_ENTITY.LABEL.NOTE'|trans({}, 'admin-messages') }}:</strong>

        <table>
            {% for note in object.notes %}
                <tr>
                    <td><strong>{{ note.notedAt ? note.notedAt.format('F j, Y') : null }}</strong></td>
                    <td style="padding-left: 20px"> {{ note.description|e }}</td>
                </tr>
            {% endfor %}
        </table>

        <div>
            <a href="{{ path('admin.company_edit', {'id': object.id}) }}">
                {{ 'VACANCY_ENTITY.BUTTON.COMPANY_NOTE_ADD'|trans({}, 'admin-messages') }}
            </a>
        </div>
        <p></p>
    </div>

    <div>
        <strong>{{ 'VACANCY_ENTITY.LABEL.NOTE'|trans({}, 'admin-messages') }}:</strong>

        <table>
            {% for vacancy in object.vacancies %}
                {% for note in vacancy.notes %}
                    <tr>
                        <td width="100px" valign="top"><strong>{{ note.notedAt ? note.notedAt.format('F j, Y') : null }}</strong></td>
                        <td> {{ note.description|e|nl2br }}</td>
                    </tr>
                    <tr style="height: 10px"></tr>
                {% endfor %}
            {% endfor %}
        </table>
        <p></p>
    </div>

    <div style="width: 300px">&nbsp;</div>
{% endblock %}
