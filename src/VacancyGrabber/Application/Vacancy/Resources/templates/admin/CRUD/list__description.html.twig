{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}
{# @var \App\VacancyGrabber\Application\Vacancy\Admin\VacancyAdmin admin #}
{# @var \App\VacancyGrabber\Domain\Vacancy\Entity\Vacancy object #}

{% block field %}

    <div>
        {{ 'VACANCY_ENTITY.LABEL.STATUS'|trans({}, 'admin-messages') }}:
        <strong>
            {{ object.status?.name ?? 'n/a' }}
        </strong>
    </div>

    <div>
        {{ 'VACANCY_ENTITY.LABEL.SOURCE'|trans({}, 'admin-messages') }}:
        <strong>
            {{ object.source ?? 'n/a' }}
        </strong>
    </div>

    <div>
        {{ 'VACANCY_ENTITY.LABEL.EXTERNAL_ID'|trans({}, 'admin-messages') }}:
        <strong>
            {{ object.externalId ?? 'n/a' }}
        </strong>
    </div>

    <div>
        {{ 'VACANCY_ENTITY.LABEL.SALARY'|trans({}, 'admin-messages') }}
        {{ object.salary ?? 'n/a' }}
    </div>

    <div>
        <a href="{{ object.url }}" target="_blank">
            {{ object.title }}
        </a>
    </div>

    <div>
        {{ object.description|e|nl2br }}
    </div>

    <div style="margin-top: 15px">
        <strong>{{ 'COMPANY_ENTITY.LABEL.NOTE'|trans({}, 'admin-messages') }}:</strong>

        <div style="max-height: 300px; overflow-y: auto; white-space: nowrap;">
            <table width="100%" border="0" cellpadding="5" cellspacing="5">
                {% for note in object.company?.notes %}
                    <tr>
                        <td valign="top" width="140px">
                            <strong>{{ note.notedAt ? note.notedAt.format('F j, Y') : null }}</strong>
                        </td>
                        <td style="max-width: 300px; overflow-wrap: break-word; white-space: normal;">
                            {% if note.user %}
                                <div>
                                    <strong>{{ note.user }}</strong>
                                </div>
                            {% endif %}
                            {{ note.description|e|nl2br }}
                        </td>
                    </tr>
                    <tr style="height: 10px">
                        <td></td>
                        <td></td>
                    </tr>
                {% endfor %}
            </table>
        </div>

        {% if object.company %}
            <div>
                <a href="{{ path('admin.company_edit', {'id': object.company.id}) }}">
                    {{ 'VACANCY_ENTITY.BUTTON.COMPANY_NOTE_ADD'|trans({}, 'admin-messages') }}
                </a>
            </div>
        {% endif %}
    </div>

    <div>
        <h4>
            {% if object.resumeSentAt %}
                <div class="alert alert-success alert-dismissable">
                    {{ 'VACANCY_ENTITY.LABEL.RESUME_SENT_AT'|trans({}, 'admin-messages') }}:
                    {{ object.resumeSentAt.format('F j, Y') }}
                </div>
            {% else %}
                {{ 'VACANCY_ENTITY.LABEL.RESUME_SENT_AT'|trans({}, 'admin-messages') }}: n/a
            {% endif %}
        </h4>

        <h4>
            {% if object.deadLineAt %}
                <div class="alert alert-warning alert-dismissable">
                    {{ 'VACANCY_ENTITY.LABEL.DEAD_LINE_AT'|trans({}, 'admin-messages') }}:
                    {{ object.deadLineAt.format('F j, Y') }}
                </div>
            {% else %}
                {{ 'VACANCY_ENTITY.LABEL.DEAD_LINE_AT'|trans({}, 'admin-messages') }}: n/a
            {% endif %}
        </h4>
    </div>

    <div style="margin-top: 15px">
        <strong>{{ 'VACANCY_ENTITY.LABEL.NOTE'|trans({}, 'admin-messages') }}:</strong>

        <div style="max-height: 300px; overflow-y: auto; white-space: nowrap;">
            <table width="100%" border="0" cellpadding="5" cellspacing="5">
                {% for note in object.notes %}
                    <tr>
                        <td valign="top" width="140px">
                            <strong>{{ note.notedAt ? note.notedAt.format('F j, Y') : null }}</strong>
                        </td>
                        <td style="max-width: 300px; overflow-wrap: break-word; white-space: normal;">
                            {% if note.user %}
                                <div>
                                    <strong>{{ note.user }}</strong>
                                </div>
                            {% endif %}
                            {{ note.description|e|nl2br }}
                        </td>
                    </tr>
                    <tr style="height: 10px">
                        <td></td>
                        <td></td>
                    </tr>
                {% endfor %}
            </table>
        </div>

        <div>
            <a class="sonata-link-identifier" href="{{ path('admin.vacancy_edit', {'id': object.id}) }}">
                {{ 'VACANCY_ENTITY.BUTTON.VACANCY_NOTE_ADD'|trans({}, 'admin-messages') }}
            </a>
        </div>
        <p></p>
    </div>

{% endblock %}
