{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}
{# @var \App\Admin\CompanyAdmin admin #}
{# @var \App\Entity\Company object #}

{% block field %}
    {% if object.url|length > 0 %}
        <h3>
            <a href="{{ object.url }}" target="_blank">{{ object.name ?? 'n/a' }}</a>
        </h3>
    {% else %}

        <h3>{{ object.name ?? 'n/a' }}</h3>
    {% endif %}

    <div>
        <a href="{{ path('admin.vacancy_list', {'filter[company][value]': object.id}) }}">
            {{ 'COMPANY_ENTITY.BUTTON.VACANCIES'|trans({}, 'admin-messages') }}
        </a>
    </div>
{% endblock %}
