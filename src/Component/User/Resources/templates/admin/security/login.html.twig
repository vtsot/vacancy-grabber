{% extends "base.html.twig" %}

{% block metaTitle %}
    {{ 'LOGIN_PAGE.TITLE'|trans({}, 'admin-messages') }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('css/admin-login') }}
{% endblock %}

{% block body %}
    <div class="login-page">
        <div class="widget">
            <h3 class="widget__header">
                {{ 'LOGIN_PAGE.TITLE'|trans({}, 'admin-messages') }}
            </h3>
            <div class="widget__body">
                {% if error is defined and error is not null %}
                    <div class="alert">
                        {{ error.message|trans(error.messageData, 'security') | raw }}
                    </div>
                {% endif %}
                <form action="{{ path('admin.login_check') }}" method="post">

                    <input id="username"
                           type="text"
                           name="_username"
                           placeholder="{{ 'LOGIN_PAGE.LABEL.USERNAME'|trans({}, 'admin-messages') }}"
                           value="{{ last_username is defined ? last_username : '' }}"
                           {{ last_username is defined and not last_username ? 'autofocus' : null }}
                    />

                    <input id="password"
                           type="password"
                           name="_password"
                           placeholder="{{ 'LOGIN_PAGE.LABEL.PASSWORD'|trans({}, 'admin-messages') }}"
                           autocomplete="new-password"
                        {{ last_username is defined and last_username ? 'autofocus' : null }}
                    />

                    <button type="submit" class="btn">
                        {{ 'LOGIN_PAGE.BUTTON.LOGIN'|trans({}, 'admin-messages') }}
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
