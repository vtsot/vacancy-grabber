{% extends '@SonataAdmin/CRUD/batch_confirmation.html.twig' %}

{% form_theme form '@SonataAdmin/Form/form_admin_fields.html.twig' %}


{% block content %}
    {{ sonata_block_include_stylesheets('js') }}
    {{ sonata_block_include_javascripts('js') }}

    <div class="sonata-ba-delete">
        <div class="box box-danger">
            <div class="box-header">
                {% if batch_translation_domain is not same as(false) %}
                    {% set action_label = action_label|trans({}, batch_translation_domain) %}
                {% endif %}
                <h4 class="box-title">{% trans with {'%action%': action_label} from 'SonataAdminBundle' %}title_batch_confirmation{% endtrans %}</h4>
            </div>
            <div class="box-body">
                {% if data.all_elements %}
                    {{ 'VACANCY_ENTITY.BATCH_ACTION.ASSIGN_CONFIRM_ALL' | trans({}, 'admin-messages') }}
                {% else %}
                    {{ 'VACANCY_ENTITY.BATCH_ACTION.ASSIGN_CONFIRM_IDS' | trans({'%count%': data.idx|length}, 'admin-messages') }}
                {% endif %}
            </div>
            <div class="box-footer clearfix">
                <form action="{{ admin.generateUrl('batch', {'filter': admin.filterParameters}) }}" method="POST">
                    <input type="hidden" name="confirmation" value="ok">
                    <input type="hidden" name="data" value="{{ data|json_encode }}">
                    <input type="hidden" name="_sonata_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="{{ action }}">

                    {{ form_row(form.user) }}

                    <div style="display: none">
                        {{ form_rest(form) }}
                    </div>

                    <button type="submit" class="btn btn-danger">
                        {{ 'btn_execute_batch_action'|trans({}, 'SonataAdminBundle') }}
                    </button>

                    {% if admin.hasRoute('list') and admin.hasAccess('list') %}
                        {{ 'delete_or'|trans({}, 'SonataAdminBundle') }}

                        <a class="btn btn-success" href="{{ admin.generateUrl('list') }}">
                            <i class="fas fa-list" aria-hidden="true"></i> {{ 'link_action_list'|trans({}, 'SonataAdminBundle') }}
                        </a>
                    {% endif %}
                </form>
            </div>
        </div>
    </div>
{% endblock %}
