<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org
                                      http://gediminasm.org/schemas/orm/doctrine-extensions-mapping
                                      https://githubusercontent.com"
>
    <entity
        table="sources"
        name="App\Domain\Source\Entity\Source"
        repository-class="App\Infrastructure\Doctrine\Repository\SourceDoctrineRepository"
    >
        <unique-constraints>
            <unique-constraint name="uniq_id" columns="id"/>
        </unique-constraints>

        <indexes>
            <index name="idx_active" columns="active" />
            <index name="fk_user_id" columns="user_id" />
            <index name="idx_created_at" columns="created_at" />
            <index name="idx_updated_at" columns="updated_at" />
        </indexes>

        <id name="id" type="uuid">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"/>
        </id>

        <field name="name" column="name" type="string" length="255" nullable="true" />
        <field name="url" column="url" type="url" length="255" nullable="true" />

        <field name="active" column="active" type="boolean" nullable="false">
            <options>
                <option name="default">1</option>
            </options>
        </field>

        <field name="grabber" column="grabber" type="string" length="255" nullable="false"
               enum-type="App\Domain\Source\Entity\SourceGrabber">
            <options>
                <option name="default">dou</option>
            </options>
        </field>

        <field name="createdAt" type="datetime_immutable" precision="6" nullable="true">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime_immutable" precision="6" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <!-- relations -->
        <many-to-one field="user" target-entity="App\Domain\User\Entity\User">
            <join-column name="user_id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <one-to-many field="vacancies"
                     target-entity="App\Domain\Vacancy\Entity\Vacancy"
                     mapped-by="source"
                     orphan-removal="false"
        >
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <one-to-many field="grabLogs"
                     target-entity="App\Domain\GrabLog\Entity\GrabLog"
                     mapped-by="source"
                     orphan-removal="false"
        >
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
