<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org
                                      http://gediminasm.org/schemas/orm/doctrine-extensions-mapping
                                      https://githubusercontent.com"
>
    <entity
        table="users"
        name="App\Domain\User\Entity\User"
        repository-class="App\Infrastructure\Doctrine\Repository\UserDoctrineRepository"
    >

        <unique-constraints>
            <unique-constraint name="uniq_id" columns="id"/>
            <unique-constraint name="uniq_email" columns="email"/>
        </unique-constraints>

        <id name="id" type="uuid">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"/>
        </id>

        <indexes>
            <index name="idx_active" columns="active"/>
            <index name="idx_google_authenticator_enabled" columns="is_google_authenticator_enabled"/>

            <index name="idx_created_at" columns="created_at" />
            <index name="idx_updated_at" columns="updated_at" />
        </indexes>

        <field name="active" column="active" type="boolean" nullable="false">
            <options>
                <option name="default">1</option>
            </options>
        </field>

        <field name="googleAuthenticatorEnabled" column="is_google_authenticator_enabled" type="boolean"
               nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>

        <field name="googleAuthenticatorToken" column="google_authenticator_token" type="string" nullable="true"/>

        <field name="firstName" column="first_name" type="string" nullable="true"/>
        <field name="lastName" column="last_name" type="string" nullable="true"/>

        <field name="email" column="email" type="string" unique="true" nullable="false"/>
        <field name="password" column="password" type="string" nullable="true"/>

        <field name="roles" column="roles" type="json" nullable="false"/>

        <field name="createdAt" type="datetime_immutable" precision="6" nullable="true">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime_immutable" precision="6" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

    </entity>
</doctrine-mapping>
