# Copy to .env.prod.local on the server and fill in real values. Never commit .env.prod.local.

# Host that Traefik routes to this project.
# Stage 1 (no domain yet): the VPS Tailscale IP, e.g. 100.91.57.78
# Stage 2: the domain, e.g. vacancy-grabber.lucked.me (published through the Cloudflare Tunnel, see docs/vps-setup.md step 18;
#          the HTTPS labels in docker-compose.prod.yaml stay commented, Cloudflare terminates TLS)
APP_DOMAIN=100.91.57.78

APP_ENV=prod
APP_DEBUG=0
# generate: openssl rand -hex 32
APP_SECRET=change-me
TIMEZONE=Europe/Kiev

# Stage 1: http://<IP>/   Stage 2: https://vacancy-grabber.lucked.me/
# Stage 2 CORS: '^https://vacancy-grabber\.lucked\.me$'
DEFAULT_URI=http://100.91.57.78/
CORS_ALLOW_ORIGIN='^https?://100\.91\.57\.78$'

# MySQL container
MYSQL_DATABASE=vacancy_grabber
MYSQL_USER=vacancy_grabber
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Must match the MYSQL_* values above
DATABASE_URL="mysql://vacancy_grabber:change-me@mysql:3306/vacancy_grabber?serverVersion=8.0.32&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Keys live in the "jwt" docker volume (make prod-jwt-keys)
JWT_PASSPHRASE=change-me
