# Copy to .env.prod.local on the server and fill in real values. Never commit .env.prod.local.

# Domain served by nginx-proxy / Let's Encrypt
APP_DOMAIN=vacancy-grabber.example.com

APP_ENV=prod
APP_DEBUG=0
# generate: openssl rand -hex 32
APP_SECRET=change-me

DEFAULT_URI=https://vacancy-grabber.example.com/
CORS_ALLOW_ORIGIN='^https://vacancy-grabber\.example\.com$'

# MySQL container
MYSQL_DATABASE=vacancy_grabber
MYSQL_USER=vacancy_grabber
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Must match the MYSQL_* values above
DATABASE_URL="mysql://vacancy_grabber:change-me@mysql:3306/vacancy_grabber?serverVersion=8.0.32&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Keys live in the "jwt" docker volume (make prod-jwt-keys)
JWT_PASSPHRASE=change-me
