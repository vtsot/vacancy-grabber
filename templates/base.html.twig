<!DOCTYPE html>
{% apply spaceless %}<html
    lang="{{ app.request.locale }}"
    data-default-locale="{{ app.request.locale }}"
    data-user-id="{{ app.user?.id }}"
>{% endapply %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Welcome!{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('css/main') }}
    {% endblock %}

    {% block javascripts %}
        {# {{ encore_entry_script_tags('app') }} #}
    {% endblock %}

</head>
<body>
{% block body %}
{% endblock %}
</body>
</html>
