{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}
{# @var \App\Admin\VacancyAdmin admin #}
{# @var \App\Entity\Vacancy object #}

{% block field %}
    {% if object.company %}
        <h3>
            <a href="{{ object.company.url }}" target="_blank">{{ object.company }}</a>
        </h3>
    {% endif %}

    <h4>
        {% if object.resumeSentAt %}
            <div class="alert alert-success alert-dismissable">
                {{ 'VACANCY_ENTITY.LABEL.RESUME_SENT_AT'|trans({}, 'admin-messages') }}:
                {{ object.resumeSentAt.format('F j, Y') }}
            </div>
        {% else %}
            {{ 'VACANCY_ENTITY.LABEL.RESUME_SENT_AT'|trans({}, 'admin-messages') }}: n/a
        {% endif %}
    </h4>

    <div>
        {{ 'VACANCY_ENTITY.LABEL.SALARY'|trans({}, 'admin-messages') }}
        {{ object.salary ?? 'n/a' }}
    </div>

    <div>
        {{ 'VACANCY_ENTITY.LABEL.SOURCE'|trans({}, 'admin-messages') }}:
        {{ object.source ?? 'n/a' }}
    </div>
{% endblock %}
