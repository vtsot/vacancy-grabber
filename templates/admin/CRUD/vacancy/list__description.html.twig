{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}
{# @var \App\Admin\VacancyAdmin admin #}
{# @var \App\Entity\Vacancy object #}

{% block field %}
    <div>
        <a class="sonata-link-identifier" href="{{ object.url }}" target="_blank">
            {{ object.title }}
        </a>
    </div>

    <div>
        {{ object.description }}
    </div>


    {% if object.company.notes|length > 0 %}
        <div>
            <strong>{{ 'COMPANY_ENTITY.LABEL.NOTE'|trans({}, 'admin-messages') }}:</strong>

            <table>
                {% for note in object.company.notes %}
                    <tr>
                        <td><strong>{{ note.notedAt ? note.notedAt.format('F j, Y') : null }}</strong></td>
                        <td style="padding-left: 20px"> {{ note.description|e }}</td>
                    </tr>
                {% endfor %}
            </table>
            <div>
                <a href="{{ path('admin.company_edit', {'id': object.company.id}) }}">
                    {{ 'VACANCY_ENTITY.BUTTON.COMPANY_NOTE_ADD'|trans({}, 'admin-messages') }}
                </a>
            </div>
            <p></p>

        </div>
    {% endif %}

    {% if object.notes|length > 0 %}
        <div>
            <strong>{{ 'VACANCY_ENTITY.LABEL.NOTE'|trans({}, 'admin-messages') }}:</strong>

            <table>
                {% for note in object.notes %}
                    <tr>
                        <td><strong>{{ note.notedAt ? note.notedAt.format('F j, Y') : null }}</strong></td>
                        <td style="padding-left: 20px"> {{ note.description|e }}</td>
                    </tr>
                {% endfor %}
            </table>

            <div>
                <a href="{{ path('admin.vacancy_edit', {'id': object.id}) }}">
                    {{ 'VACANCY_ENTITY.BUTTON.VACANCY_NOTE_ADD'|trans({}, 'admin-messages') }}
                </a>
            </div>
            <p></p>
        </div>
    {% endif %}

{% endblock %}
