{% extends '@!NelmioApiDoc/SwaggerUi/index.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            margin: 0;
        }
    </style>
{% endblock stylesheets %}

{% block swagger_initialization %}
    <script type="text/javascript">
        (function () {
            window.onload = loadSwaggerUI({{ swagger_ui_config|merge({'tagsSorter': 'alpha', 'defaultModelsExpandDepth': -1})|json_encode(65)|raw }});
        })();
    </script>
{% endblock swagger_initialization %}

{% block header_block %}
{% endblock %}
