{% extends 'base.html.twig' %}

{%- block body -%}

    <div id="app">

        <v-progress-linear indeterminate v-if="globalStore.isLoading()"></v-progress-linear>
        <v-app v-else>

            <app-header>
                <template #header-title>
                    {% block header_title %}
                        {{ header_title ?? null }}
                    {% endblock %}
                </template>

                <template #header-navigation>
                    {% block header_navigation %}

                        {# @var \App\DTO\HeaderNavigation\HeaderNavigationDTO[] navigation #}
                        {# @var \App\DTO\HeaderNavigation\HeaderNavigationDTO sub1 #}
                        {# @var \App\DTO\HeaderNavigation\HeaderNavigationDTO item #}
                        {% set navigationItems = getHeaderNavigationItems() %}
                        {% set navigationOpened = getHeaderNavigationOpened() %}
                        {% if navigationItems %}
                            <v-list :opened="{{ navigationOpened|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}">
                                {% for item in navigationItems %}
                                    <v-list-group
                                        key="{{ item.key }}"
                                        value="{{ item.key }}"
                                        title="{{ item.title }}"
                                    >
                                        <template v-slot:activator="{ props }">
                                            <v-list-item title="{{ item.title }}" v-bind="props"></v-list-item>
                                        </template>
                                        {% for sub1 in item.items %}
                                            <v-list-item
                                                title="{{ sub1.title }}"
                                                link
                                                {{ sub1.active ? 'active' : null }}
                                                href="{{ sub1.url }}"
                                            ></v-list-item>
                                        {% endfor %}
                                    </v-list-group>
                                {% endfor %}
                            </v-list>
                        {% endif %}

                    {% endblock %}
                </template>
            </app-header>

            <v-main>
                <app-alert></app-alert>
                <app-flash></app-flash>
                <v-card-text>
                    {% block content %}
                    {% endblock %}
                </v-card-text>
            </v-main>
            <v-divider class="my-2"/>

        </v-app>

    </div>

{%- endblock -%}
