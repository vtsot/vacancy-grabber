{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "items": {
            "type": "array",
            "items": [
                {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "active": {
                            "type": "boolean"
                        },
                        "first_name": {
                            "type": "string"
                        },
                        "last_name": {
                            "type": "string"
                        },
                        "email": {
                            "type": "string"
                        },
                        "roles": {
                            "type": "array",
                            "items": [
                                {
                                    "type": "string"
                                }
                            ]
                        },
                        "created_at": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "active",
                        "first_name",
                        "last_name",
                        "email",
                        "roles",
                        "created_at"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "meta": {
            "type": "object",
            "properties": {
                "paginator": {
                    "type": "object",
                    "properties": {
                        "current_page": {
                            "type": "integer"
                        },
                        "items_per_page": {
                            "type": "integer"
                        },
                        "total_items": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "current_page",
                        "items_per_page",
                        "total_items"
                    ],
                    "additionalProperties": false
                },
                "filters": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": ["null", "string"]
                        },
                        "available_filters": {
                            "type": "object",
                            "properties": {
                                "query": {
                                    "type": "boolean"
                                },
                                "is_active": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "query",
                                "is_active"
                            ],
                            "additionalProperties": false
                        },
                        "order": {
                            "type": "string"
                        },
                        "available_orders": {
                            "type": "array",
                            "items": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "string"
                                }
                            ]
                        },
                        "applied_filters": {
                            "type": "object",
                            "properties": {
                                "query": {
                                    "type": ["string", "null"]
                                },
                                "is_active": {
                                    "type": ["boolean", "null"]
                                }
                            },
                            "required": [
                                "query",
                                "is_active"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "required": [
                        "query",
                        "available_filters",
                        "order",
                        "available_orders",
                        "applied_filters"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "paginator",
                "filters"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "items",
        "meta"
    ],
    "additionalProperties": false
}
